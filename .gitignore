# Host-local Claude settings are not part of the portable Life OS package.
.claude/*

# Local evaluation output, when a reviewer chooses to create it.
evals/outputs/
.DS_Store

# Internal development docs (author-only, not published)
# docs/ is public by default (tracked); devdocs/ holds brainstorms,
# research reports, deprecated architecture docs, and internal rules.
devdocs/

# Python caches
__pycache__/
*.py[cod]
*$py.class

# Tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Local backup dir (from tools/backup.py tests)
backup/
_meta/
