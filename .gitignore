# Claude Code local installation (generated from repo source files)
# v1.8.5: slash commands replace retired bash hooks and MUST travel with repo
# so user clone gets working /verify-release, /check-spec-drift, etc.
# Use .claude/* + negation pattern (trailing-slash ignore blocks negation).
.claude/*
!.claude/commands/

# Eval outputs (generated, not tracked)
evals/outputs/
.DS_Store

# Internal development docs (author-only, not published)
# docs/ is public by default (tracked); devdocs/ holds brainstorms,
# research reports, deprecated architecture docs, and internal rules.
devdocs/

# Compliance incident archives (contain sanitized but sensitive context)
compliance/*.md
!compliance/violations.md
!compliance/violations.example.md
# Whitelist: spec-violation and court-start incident dossiers (high info-density,
# long-term value, sanitized-safe — track in git so they travel with the repo).
!compliance/*-spec-violation.md
!compliance/*-court-*.md
!compliance/*-incident-*.md

# Python caches
__pycache__/
*.py[cod]
*$py.class

# Tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Local backup dir (from tools/backup.py tests)
backup/
_meta/
